{
  "name": "chemdiag-ai",
  "version": "1.0.0",
  "description": "Explainable AI-Based Fault Diagnosis and Root-Cause Analysis for Chemical Processes",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node start_all.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install",
    "setup": "npm install && npm run setup:backend && npm run setup:frontend",
    "build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0"
  },
  "keywords": [
    "chemical-engineering",
    "ai",
    "fault-diagnosis",
    "esp32",
    "explainable-ai"
  ],
  "author": "ChemDiag AI Team",
  "license": "MIT"
}
